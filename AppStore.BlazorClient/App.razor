@using AppStore.Frontend.Views.Pages.Product.ActivateProduct
@using AppStore.Frontend.Views.Pages.Product.CreateProduct
@using AppStore.Frontend.Views.Pages.Product.DeleteProduct
@using AppStore.Frontend.Views.Pages.Product.GetAllProducts
@using AppStore.Frontend.Views.Pages.Product.UpdateProduct
<Router AppAssembly="@typeof(App).Assembly" 
AdditionalAssemblies=AdditionalAssemblies>
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
@code {
    Assembly[] AdditionalAssemblies =>
    new Assembly[]
    {
typeof(CreateProduct)
.Assembly,
typeof(GetAllProducts)
.Assembly,
typeof(UpdateProduct)
.Assembly,
typeof(DeleteProduct)
.Assembly,
typeof(ActivateProduct)
.Assembly

    };
}
