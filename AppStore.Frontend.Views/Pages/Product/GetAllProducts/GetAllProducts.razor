@using AppStore.Frontend.Views.Components.Product.GetAllProducts
@using AppStore.Frontend.Views.Resources

@page "/getallproducts"

<PageTitle>@GetAllProductsMessages.PageTitle</PageTitle>

<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <GetAllProductsComponent Products="ViewModel"
                                 OnCreate="GoToCreate"
                                 OnEdit="GoToEdit"
                                 OnDelete="GoToDelete"
                                 OnActivate="GoToActivate"/>
    </ChildContent>

    <ErrorContent>
        <ExceptionDisplay Exception="context" />

        <button class="btn btn-danger" @onclick="Recover">
            @CommonMessages.OK
        </button>
    </ErrorContent>
</ErrorBoundary>
