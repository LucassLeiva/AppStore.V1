@using AppStore.Frontend.Views.Resources
@using AppStore.Frontend.Views.ViewModels.Product.GetAllProducts
@using static AppStore.Frontend.Views.ViewModels.Product.GetAllProducts.GetAllProductsViewModel

<h3>@GetAllProductsMessages.PageTitle</h3>

<div class="row align-items-end">
    <div class="col-6">
        <label class="form-label">@GetAllProductsMessages.StateLabel</label>

        <InputSelect class="form-select"
        @bind-Value="Products.StateFilter"
        @bind-Value:after="OnFilterChanged">
            <option value="@ProductStateFilter.Active">Activos</option>
            <option value="@ProductStateFilter.Inactive">Inactivos</option>
            <option value="@ProductStateFilter.All">Todos</option>
        </InputSelect>
    </div>

    <div class="col-6 text-end">
        <button class="btn btn-primary" @onclick="Create">
            Crear nuevo producto
        </button>
    </div>
</div>

<hr />

@if (!string.IsNullOrWhiteSpace(Products.InformationMessage))
{
    <div class="alert alert-info">
        @Products.InformationMessage
    </div>
}

@if (Products.Products.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@GetAllProductsMessages.IdLabel</th>

                <th>@GetAllProductsMessages.NameLabel</th>
                <th>@GetAllProductsMessages.CategoryLabel</th>
                <th>@GetAllProductsMessages.SupplierLabel</th>
                <th>@GetAllProductsMessages.PriceLabel</th>
                <th>@GetAllProductsMessages.StockLabel</th>          
                <th>@GetAllProductsMessages.StateLabel</th>
                <th>@GetAllProductsMessages.InternalCodeLabel</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Products.Products)
            {
                <tr>
                    <td>@p.IdProduct</td>

                    <td>@p.Name</td>
                    <td>@p.CategoryName</td>
                    <td>@p.SupplierName</td>
                    <td>@p.Price</td>
                    <td>@p.StockAmount</td>                  
                    <td>
                        @(p.State == 1
                                ? GetAllProductsMessages.ActiveText
                                : GetAllProductsMessages.InactiveText)
                    </td>
                    <td>@p.InternalCode</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() => Edit(p.IdProduct)">
                            Editar
                        </button>

                        @if (p.State == 1)
                        {
                            <button class="btn btn-sm btn-outline-danger ms-2"
                                    @onclick="() => Delete(p.IdProduct)">
                                Eliminar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success ms-2"
                                    @onclick="() => Activate(p.IdProduct)">
                                Activar
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* @code {
    private Task Create() => OnCreate.InvokeAsync();

    private Task Edit(int idProduct) => OnEdit.InvokeAsync(idProduct);
    private Task Delete(int idProduct) => OnDelete.InvokeAsync(idProduct);
    private async Task Activate(int idProduct) => await Products.Load();
   

    

    private async Task OnFilterChanged()
    {
        // Carga/filtra al cambiar el select
        await Products.Load();
    }
} *@
