@using AppStore.Frontend.Views.Resources.Product.UpdateProduct
@using AppStore.Frontend.Views.ViewModels.Product.UpdateProduct

<h3>@UpdateProductMessages.UpdateProductPageTitle</h3>

@if (!string.IsNullOrWhiteSpace(Model.InformationMessage))
{
    <div class="alert alert-info">
        @Model.InformationMessage
    </div>
}

<EditForm Model="Model" OnValidSubmit="SaveInternal">

   
    <ModelValidator Validator="Model.Validator"
                    @ref=Model.ModelValidatorComponentReference />
    @* Para mostrar el mensaje arriba de forma general *@
    @* <ValidationSummary /> *@
    <div class="row g-3">

        @* <div class="col-12 col-md-3">
            <label class="form-label">@UpdateProductMessages.ProductIdLabel</label>
            <input class="form-control" value="@Model.IdProduct" disabled />
        </div> *@

        <div class="col-12 col-md-3">
            <label class="form-label">@UpdateProductMessages.InternalCodeLabel</label>
            <InputText class="form-control" @bind-Value="Model.Model.InternalCode"
                       @onblur="() => Model.NormalizeInternalCode()" />
            <ValidationMessage For="() => Model.Model.InternalCode" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">@UpdateProductMessages.NameLabel</label>
            <InputText class="form-control" @bind-Value="Model.Model.Name"
                       @onblur="() => Model.NormalizeName()" />
            <ValidationMessage For="() =>Model.Model.Name" />
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">@UpdateProductMessages.PriceLabel</label>
            <InputNumber class="form-control" @bind-Value="Model.Model.Price" min="0"
             ParsingErrorMessage="El Precio debe ser un número válido." />
            <ValidationMessage For="() => Model.Model.Price" />
        </div>


        <div class="col-12 col-md-3">
            <label class="form-label">@UpdateProductMessages.StockAmountLabel</label>
            <InputNumber class="form-control" @bind-Value="Model.Model.StockAmount" min="0"
             ParsingErrorMessage="La Cantidad debe ser un número válido." />
            <ValidationMessage For="() => Model.Model.StockAmount" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">@UpdateProductMessages.DescriptionLabel</label>
            <InputTextArea class="form-control" @bind-Value="Model.Model.Description" rows="3"
                           @onblur="() => Model.NormalizeDescription()" />
            <ValidationMessage For="() => Model.Model.Description" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">@UpdateProductMessages.CategoryIdLabel</label>

            <InputSelect class="form-select"
                         @bind-Value="Model.Model.IdCategory">

                @foreach (var c in Model.Model.Categories)
                {
                    <option value="@c.IdCategory">@c.Name</option>
                }

            </InputSelect>
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">@UpdateProductMessages.SupplierIdLabel</label>

            <InputSelect class="form-select"
                         @bind-Value="Model.Model.IdSupplier">

                @foreach (var s in Model.Model.Suppliers)
                {
                    <option value="@s.IdSupplier">@s.Name</option>
                }

            </InputSelect>
        </div>

        <div class="col-12 d-flex gap-2 justify-content-end mt-3">
            <button type="submit" class="btn btn-primary">
                @UpdateProductMessages.SaveButtonText
            </button>

            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                @UpdateProductMessages.CancelButtonText
            </button>
        </div>
    </div>
</EditForm>

@* @code
{
    private async Task SaveInternal()
    {
        await Model.Save();
 
    }

    private Task Cancel()
        => OnCancel.HasDelegate ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
 *@