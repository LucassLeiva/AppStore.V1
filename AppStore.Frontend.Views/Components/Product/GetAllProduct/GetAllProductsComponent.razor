@using AppStore.Frontend.Views.Resources

<h3>@GetAllProductsMessages.PageTitle</h3>

<div class="row align-items-end">
    <div class="col-6">
        <div class="form-check">
            <InputCheckbox class="form-check-input"
                           id="includeInactive"
                           @bind-Value="Products.IncludeInactive" />
            <label class="form-check-label" for="includeInactive">
                @GetAllProductsMessages.IncludeInactiveLabel
            </label>
        </div>
    </div>

    <div class="col-6 text-end">
        <button class="btn btn-primary" @onclick="Products.Load">
            @GetAllProductsMessages.LoadButtonText
        </button>
    </div>
</div>

<hr />

@if (!string.IsNullOrWhiteSpace(Products.InformationMessage))
{
    <div class="alert alert-info">
        @Products.InformationMessage
    </div>
}

@if (Products.Products.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@GetAllProductsMessages.IdLabel</th>
                <th>@GetAllProductsMessages.NameLabel</th>
                <th>@GetAllProductsMessages.CategoryLabel</th>
                <th>@GetAllProductsMessages.SupplierLabel</th>
                <th>@GetAllProductsMessages.PriceLabel</th>
                <th>@GetAllProductsMessages.StockLabel</th>
                <th>@GetAllProductsMessages.StateLabel</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Products.Products)
            {
                <tr>
                    <td>@p.IdProduct</td>
                    <td>@p.Name</td>
                    <td>@p.CategoryName</td>
                    <td>@p.SupplierName</td>
                    <td>@p.Price</td>
                    <td>@p.StockAmount</td>
                    <td>
                        @(p.State == 1
                        ? GetAllProductsMessages.ActiveText
                        : GetAllProductsMessages.InactiveText)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
