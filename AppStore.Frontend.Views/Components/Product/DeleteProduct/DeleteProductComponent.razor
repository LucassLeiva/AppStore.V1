@using AppStore.Frontend.Views.Resources.Product.DeleteProduct
@using AppStore.Frontend.Views.ViewModels.Product.DeleteProduct

@if (Show)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">@DeleteProductMessages.ConfirmDeleteTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelInternal"></button>
                </div>

                <div class="modal-body">
                    <p>@DeleteProductMessages.ConfirmDeleteMessage</p>

                    <div class="alert alert-warning mb-0">
                        @DeleteProductMessages.ConfirmDeleteWarning
                        <p class="text-muted mb-0">
                            <strong>@DeleteProductMessages.ProductNameLabel:</strong> @Model.ProductName
                        </p>
                        <p class="text-muted mb-0">
                            <strong>@DeleteProductMessages.ProductIdLabel:</strong> @IdProduct
                        </p>
                    </div>
   

                    @if (!string.IsNullOrWhiteSpace(Model.InformationMessage))
                    {
                        <div class="alert alert-info mt-3">
                            @Model.InformationMessage
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CancelInternal"
                            disabled="@IsBusy">
                        @DeleteProductMessages.CancelButtonText
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="DeleteInternal"
                            disabled="@IsBusy">
                        @DeleteProductMessages.DeleteButtonText
                    </button>
                </div>

            </div>
        </div>
    </div>
}
