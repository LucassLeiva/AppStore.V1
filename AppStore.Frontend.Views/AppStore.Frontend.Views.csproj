<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppStore.Frontend.BusinessObjects\AppStore.Frontend.BusinessObjects.csproj" />
    <ProjectReference Include="..\AppStore.RazorComponents\AppStore.RazorComponents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\CommonMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CommonMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Product\ActivateProduct\ActivateProductMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ActivateProductMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Product\CreateProduct\CreateProductMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CreateProductMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Product\DeleteProduct\DeleteProductMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DeleteProductMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Product\GetAllProducts\GetAllProductsMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GetAllProductsMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Product\UpdateProduct\UpdateProductMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UpdateProductMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\CommonMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CommonMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Product\ActivateProduct\ActivateProductMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ActivateProductMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Product\CreateProduct\CreateProductMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CreateProductMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Product\DeleteProduct\DeleteProductMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DeleteProductMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Product\GetAllProducts\GetAllProductsMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GetAllProductsMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Product\UpdateProduct\UpdateProductMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>UpdateProductMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
